# Frontend build settings. Copy to .env only if you need them locally; never commit the real file.
# Public origin of karrie-api; leave empty to use the dev proxy.
VITE_API_ORIGIN=
# Umami Cloud tracker, added to production builds only. Both values are public (they end up in index.html).
# The tracker only counts visits on karrie.eu (and the old karrieapp.onrender.com), so local builds never send anything.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
