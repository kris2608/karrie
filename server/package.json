{
  "name": "karrie-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "vitest run",
    "candidates:export": "node scripts/export-candidates.mjs",
    "voice:audition": "node scripts/voice-audition.mjs",
    "voice:generate": "node --experimental-strip-types scripts/voice-library.mjs",
    "voice:library": "node --experimental-strip-types scripts/voice-library.mjs"
  },
  "dependencies": {
    "openai": "^7.53.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
