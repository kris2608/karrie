# Copy to server/.env for local runs. Never commit the real file.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
# low | high | auto
OPENAI_IMAGE_DETAIL=auto
# none | low | medium | high | default (omit the parameter)
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=30000

# Brave Image Search for branded packs (https://api-dashboard.search.brave.com). Leave empty to use OpenAI web search.
BRAVE_SEARCH_API_KEY=
# USD per Brave request, used for the daily budget.
PRICE_BRAVE_CALL=0.005

ALLOWED_ORIGINS=https://karrie.eu,https://www.karrie.eu,https://karrieapp.onrender.com,http://localhost:5173,http://localhost:4173
# Requests without an Origin header (curl, scripts) are refused unless this is false.
REQUIRE_ORIGIN=true

LIMIT_PER_IP_HOUR=20
LIMIT_PER_IP_DAY=60
LIMIT_DAILY_REQUESTS=300
DAILY_BUDGET_USD=1

# Barcode lookups: Open Food Facts first, then one OpenAI web search for unknown codes.
# Open Food Facts asks for an identifying User-Agent with a contact address.
OFF_USER_AGENT=Karrie/1.0 (https://karrie.eu)
# off = never search the web for an unknown barcode.
BARCODE_WEB_SEARCH=on
# Once the budget is spent only the web search stops; Open Food Facts lookups keep working.
# The counts apply to every lookup the server has not cached.
BARCODE_DAILY_BUDGET_USD=0.5
BARCODE_LIMIT_PER_IP_HOUR=60
BARCODE_LIMIT_PER_IP_DAY=200
BARCODE_LIMIT_DAILY_REQUESTS=1000

# Products a parent types in that the catalog lacks. Only the typed name reaches the server.
# OPENAI_PRODUCT_MODEL=gpt-5.4-mini
PRODUCTS_LIMIT_PER_IP_HOUR=30
PRODUCTS_LIMIT_PER_IP_DAY=100
PRODUCTS_LIMIT_DAILY_REQUESTS=1000
PRODUCTS_DAILY_BUDGET_USD=0.5
# Catalog candidates live in memory unless a file is set (needs a persistent disk on Render).
CANDIDATES_FILE=
# Bearer token for GET/POST /api/admin/candidates; empty means those routes do not exist.
CANDIDATES_ADMIN_TOKEN=

# Generated Karrie-style drawings cost about $0.011 each (gpt-image-1, low, 1024x1024). Off unless "true".
ILLUSTRATIONS_ENABLED=false
ILLUSTRATION_MODEL=gpt-image-1
PRICE_ILLUSTRATION=0.011
ILLUSTRATION_DAILY_BUDGET_USD=1
ILLUSTRATION_LIMIT_PER_IP_HOUR=5
ILLUSTRATION_LIMIT_PER_IP_DAY=10
ILLUSTRATION_LIMIT_DAILY_REQUESTS=100

# USD per million tokens, used for the daily budget.
PRICE_INPUT_PER_MTOK=0.75
PRICE_CACHED_INPUT_PER_MTOK=0.075
PRICE_OUTPUT_PER_MTOK=4.5

PORT=8787
